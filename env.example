# =========================================================================
# Leo: Multi-Agent AI Tutor - environment schema
# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env        (Windows: copy .env.example .env)
# NEVER commit the real .env file (it is listed in .gitignore).
# =========================================================================

# ---- LLM selection -------------------------------------------------------
# "provider/model" string. Examples:
#   openai/gpt-4o-mini
#   groq/<model-id-available-to-your-key>     e.g. groq/openai/gpt-oss-120b
#   gemini/<current-gemini-model>
#   anthropic/<your-anthropic-model-id>
# Model names change over time; check your provider's console for current ones.
LEO_MODEL=openai/gpt-4o-mini
LEO_TEMPERATURE=0.3

# ---- Provider API keys (fill in ONLY the provider you selected above) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: override the Groq OpenAI-compatible endpoint
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Optional tools ------------------------------------------------------
# If set, the Explainer gets a web-search tool (https://serper.dev).
SERPER_API_KEY=

# ---- Tutor behaviour -----------------------------------------------------
# Score (0-100) below which the Evaluator triggers the feedback loop.
LEO_PASS_THRESHOLD=70
# Max number of re-teach cycles before Leo finishes anyway.
LEO_MAX_RETEACH_LOOPS=2
# CrewAI agent memory (true/false). Use false if you see embedding/OpenAI key errors.
LEO_AGENT_MEMORY=false
# Verbose agent logs in the console (true/false).
LEO_VERBOSE=true

# ---- CrewAI ----------------------------------------------------------------
# Avoids the "share execution trace?" prompt in the terminal.
CREWAI_TRACING_ENABLED=false
